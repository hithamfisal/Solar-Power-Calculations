{
  "name": "albahith-solar-calculator",
  "private": true,
  "version": "1.0.0",
  "description": "Smart Solar Power Calculator - Eng. Hitham Fisal Ahmed Fuad",
  "author": "Eng. Hitham Fisal Ahmed Fuad - Albahith Engineering",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dist:win": "pnpm run build && electron-builder --win nsis portable",
    "android:sync": "pnpm run build && cap sync android",
    "android:open": "cap open android",
    "ios:sync": "pnpm run build && cap sync ios",
    "ios:open": "cap open ios",
    "android:run": "powershell -NoProfile -ExecutionPolicy Bypass -File Run-Android.ps1",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:signing:configure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-android-signing.ps1",
    "android:aab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@fontsource/ibm-plex-sans-arabic": "^5.2.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "es-abstract": "^1.24.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright": "^1.61.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.albahith.solarcalculator",
    "productName": "Albahith Solar Calculator",
    "artifactName": "Albahith-Solar-Calculator-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Albahith-Solar-Calculator-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "حاسبة الطاقة الشمسية"
    },
    "portable": {
      "artifactName": "Albahith-Solar-Calculator-Portable-${version}-${arch}.${ext}"
    }
  },
  "packageManager": "pnpm@11.13.0"
}
